# Public URL of the app. Used for links in emails, cookies (Secure when https) and origin checks.
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL=postgres://doc:doc@localhost:5432/doc
DATABASE_POOL_MAX=5
# Set when running behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Uploaded files: "local" (STORAGE_PATH) or "s3".
STORAGE_DRIVER=local
STORAGE_PATH=./data/storage
FILE_SIZE_LIMIT=52428800
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email: "log" (prints recipient and subject only) or "smtp".
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=docs@example.com
MAIL_FROM_NAME=Docs
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Implicit TLS (usually port 465). Otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Set to 0 to turn off per-request access logs.
LOG_REQUESTS=1

# Single sign-on (optional) through an OpenID Connect identity provider. Leave AUTH_ISSUER unset to keep
# password sign-in only. See "Single sign-on (optional)" in the README.
# Issuer URL of the identity provider; setting it turns single sign-on on.
# AUTH_ISSUER=https://auth.example.com
# OAuth client id and secret registered for this app (a confidential client).
# AUTH_CLIENT_ID=doc
# AUTH_CLIENT_SECRET=
# Callback URL registered for the client. Defaults to APP_URL + /api/auth/callback.
# AUTH_REDIRECT_URI=https://docs.example.com/api/auth/callback
# Private-network URL of the same issuer for server-to-server calls.
# AUTH_BACKCHANNEL_URL=http://auth.internal:3000
# The service name in tokens' "aud", when it differs from the client id.
# AUTH_AUDIENCE=
# Also keep password sign-in, password resets and invitations while single sign-on is on; accounts linked to the
# provider still sign in only through it.
# AUTH_LOCAL_LOGIN=false
# Link existing accounts to provider accounts on their first sign-in: <local email>=<provider username>,...
# AUTH_LINK_USERS=alice@example.com=alice,bob@example.com=bob
