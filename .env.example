# Public URL of the app. Used for links in emails, cookies (Secure when https) and origin checks.
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL=postgres://doc:doc@localhost:5432/doc
DATABASE_POOL_MAX=5
# Set when running behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Uploaded files: "local" (STORAGE_PATH) or "s3".
STORAGE_DRIVER=local
STORAGE_PATH=./data/storage
FILE_SIZE_LIMIT=52428800
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email: "log" (prints recipient and subject only) or "smtp".
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=docs@example.com
MAIL_FROM_NAME=Docs
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Implicit TLS (usually port 465). Otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Set to 0 to turn off per-request access logs.
LOG_REQUESTS=1
