{
  "name": "doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run dev-client & bun run dev-server",
    "dev-client": "vite",
    "dev-server": "bun --watch ./src/server/start.ts",
    "build": "bun run build-server && bun run build-client",
    "build-server": "bun build ./src/server/start.ts --target bun --outfile ./build/server/bundle.js",
    "build-client": "vite build",
    "start": "bun ./build/server/bundle.js",
    "test": "bun test src",
    "lint": "bun --bun eslint src",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.3.0",
    "happy-dom": "20.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
